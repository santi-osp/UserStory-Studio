{
  "name": "front-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration=dev",
    "start:local": "ng serve --configuration=local",
    "build": "ng build",
    "build:qa": "ng build --configuration=qa",
    "build:dev": "ng build --configuration=dev",
    "build:local": "ng build --configuration=local",
    "build:prod": "ng build --configuration=production",
    "test": "ng test",
    "test:ci": "ng test --watch=false --code-coverage --browsers=ChromeHeadless",
    "lint": "ng lint",
    "audit:ci": "npm audit --omit=dev --audit-level=high"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.25",
    "@angular/compiler": "^20.3.25",
    "@angular/core": "^20.3.25",
    "@angular/forms": "^20.3.25",
    "@angular/platform-browser": "^20.3.25",
    "@angular/router": "^20.3.25",
    "autoprefixer": "^10.4.27",
    "dompurify": "^3.4.11",
    "ngx-quill": "^28.0.2",
    "postcss": "^8.5.18",
    "quill": "2.0.2",
    "rxjs": "~7.8.0",
    "tailwindcss": "^3.4.19",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.29",
    "@angular/cli": "^20.3.29",
    "@angular/compiler-cli": "^20.3.25",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "20.7.0",
    "eslint": "^9.39.1",
    "jasmine-core": "~5.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "karma-junit-reporter": "^2.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.46.4"
  },
  "overrides": {
    "brace-expansion@>=1.0.0 <2.0.0": "1.1.17",
    "brace-expansion@>=2.0.0 <3.0.0": "2.1.3",
    "postcss": "$postcss",
    "picomatch@^2.0.0": "2.3.2",
    "picomatch@^4.0.0": "4.0.4"
  }
}
