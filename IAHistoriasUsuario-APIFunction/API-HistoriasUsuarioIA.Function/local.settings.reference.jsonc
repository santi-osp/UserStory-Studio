  "RequestValidation": {
    "MaxJsonDepth": { "appSetting": "RequestValidation__MaxJsonDepth", "purpose": "Profundidad unica para validacion y serializacion JSON.", "type": "integer", "default": 32, "minimum": 1, "maximum": 64, "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 64, "invalidConsequence": "El proceso falla al iniciar." },
