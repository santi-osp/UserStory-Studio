    "AiBodyBytes": { "appSetting": "RequestLimits__AiBodyBytes", "purpose": "Maximo de body para generacion/evaluacion IA.", "type": "integer", "default": 2097152, "minimum": 1, "maximum": 4194304, "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 4194304, "invalidConsequence": "El proceso falla al iniciar." },
    "WorkItemBodyBytes": { "appSetting": "RequestLimits__WorkItemBodyBytes", "purpose": "Maximo de body para creacion de Work Items/Test Cases.", "type": "integer", "default": 2097152, "minimum": 1, "maximum": 4194304, "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 4194304, "invalidConsequence": "El proceso falla al iniciar." },
