{
  // Referencia jerarquica; Azure Functions no lee este archivo.
  // Cada objeto con "appSetting" representa exactamente una clave plana del example y de Azure App Settings.
  // "absoluteCeiling" es una politica fija en codigo y nunca se publica como App Setting.
  // Toda configuracion invalida produce OptionsValidationException durante el arranque.
  "FunctionHost": {
    "AzureWebJobsStorage": { "appSetting": "AzureWebJobsStorage", "purpose": "Storage requerido por el host de Functions.", "type": "string", "default": "UseDevelopmentStorage=true", "minimum": null, "maximum": null, "required": true, "secret": true, "conditionalProvider": null, "optional": false, "absoluteCeiling": "Conexion valida segun el ambiente", "invalidConsequence": "El host no inicia o no puede operar." },
    "WorkerRuntime": { "appSetting": "FUNCTIONS_WORKER_RUNTIME", "purpose": "Selecciona el worker .NET isolated.", "type": "string", "default": "dotnet-isolated", "minimum": null, "maximum": null, "required": true, "secret": false, "conditionalProvider": null, "optional": false, "absoluteCeiling": "dotnet-isolated", "invalidConsequence": "El host no carga el worker correcto." },
    "ExtensionVersion": { "appSetting": "FUNCTIONS_EXTENSION_VERSION", "purpose": "Fija la linea mayor del runtime Azure Functions.", "type": "string", "default": "~4", "minimum": null, "maximum": null, "required": true, "secret": false, "conditionalProvider": null, "optional": false, "absoluteCeiling": "~4", "invalidConsequence": "El host puede usar una version incompatible." }
  },

  "AiConnection": {
    "Provider": { "appSetting": "AiConnection__Provider", "purpose": "Selecciona un unico proveedor de IA sin fallback.", "type": "string", "default": null, "minimum": null, "maximum": null, "required": true, "secret": false, "conditionalProvider": null, "optional": false, "absoluteCeiling": "OpenAI o N8n", "invalidConsequence": "El proceso falla al iniciar." },
    "TimeoutSeconds": { "appSetting": "AiConnection__TimeoutSeconds", "purpose": "Timeout por intento IA; junto con retries y demora no puede superar 600000 ms totales.", "type": "integer", "default": 100, "minimum": 1, "maximum": 300, "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 300, "invalidConsequence": "El proceso falla al iniciar." },
    "RetryCount": { "appSetting": "AiConnection__RetryCount", "purpose": "Reintentos solo para fallos transitorios y dentro del presupuesto total de 600000 ms.", "type": "integer", "default": 0, "minimum": 0, "maximum": 5, "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 5, "invalidConsequence": "El proceso falla al iniciar." },
    "RetryDelayMilliseconds": { "appSetting": "AiConnection__RetryDelayMilliseconds", "purpose": "Espera fija entre reintentos IA, incluida en el presupuesto total de 600000 ms.", "type": "integer", "default": 250, "minimum": 0, "maximum": 60000, "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 60000, "invalidConsequence": "El proceso falla al iniciar." },
    "MaxResponseBodyBytes": { "appSetting": "AiConnection__MaxResponseBodyBytes", "purpose": "Maximo de bytes leidos de una respuesta IA.", "type": "integer", "default": 4194304, "minimum": 1, "maximum": 8388608, "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 8388608, "invalidConsequence": "El proceso falla al iniciar." },
    "MaxPromptLength": { "appSetting": "AiConnection__MaxPromptLength", "purpose": "Maximo de caracteres por prompt de entrada.", "type": "integer", "default": 500000, "minimum": 1, "maximum": 500000, "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 500000, "invalidConsequence": "El proceso falla al iniciar." },
    "MaxModelLength": { "appSetting": "AiConnection__MaxModelLength", "purpose": "Maximo de caracteres de un identificador de modelo.", "type": "integer", "default": 128, "minimum": 1, "maximum": 128, "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 128, "invalidConsequence": "El proceso falla al iniciar." },
    "OpenAI": {
      "ApiKey": { "appSetting": "AiConnection__OpenAI__ApiKey", "purpose": "Credencial enviada solo a OpenAI.", "type": "string", "default": null, "minimum": null, "maximum": null, "required": true, "secret": true, "conditionalProvider": "OpenAI", "optional": false, "absoluteCeiling": "No placeholders; nunca se registra", "invalidConsequence": "El proceso falla al iniciar cuando Provider=OpenAI." },
      "BaseUrl": { "appSetting": "AiConnection__OpenAI__BaseUrl", "purpose": "URL base absoluta de OpenAI.", "type": "uri", "default": null, "minimum": null, "maximum": null, "required": true, "secret": false, "conditionalProvider": "OpenAI", "optional": false, "absoluteCeiling": "HTTPS sin user-info ni fragment", "invalidConsequence": "El proceso falla al iniciar cuando Provider=OpenAI." },
      "DefaultModel": { "appSetting": "AiConnection__OpenAI__DefaultModel", "purpose": "Modelo usado cuando el request no lo especifica.", "type": "string", "default": null, "minimum": 1, "maximum": "AiConnection__MaxModelLength", "required": true, "secret": false, "conditionalProvider": "OpenAI", "optional": false, "absoluteCeiling": 128, "invalidConsequence": "El proceso falla al iniciar cuando Provider=OpenAI." }
    },
    "N8n": {
      "Url": { "appSetting": "AiConnection__N8n__Url", "purpose": "Webhook HTTPS del proveedor N8n.", "type": "uri", "default": null, "minimum": null, "maximum": null, "required": true, "secret": true, "conditionalProvider": "N8n", "optional": false, "absoluteCeiling": "HTTPS sin user-info ni fragment", "invalidConsequence": "El proceso falla al iniciar cuando Provider=N8n." },
      "DefaultModel": { "appSetting": "AiConnection__N8n__DefaultModel", "purpose": "Modelo enviado al webhook cuando el request no lo especifica.", "type": "string", "default": null, "minimum": 1, "maximum": "AiConnection__MaxModelLength", "required": true, "secret": false, "conditionalProvider": "N8n", "optional": false, "absoluteCeiling": 128, "invalidConsequence": "El proceso falla al iniciar cuando Provider=N8n." }
    }
  },

  "AzureDevOps": {
    "Search": {
      "DefaultTop": { "appSetting": "AzureDevOps__Search__DefaultTop", "purpose": "Cantidad predeterminada de resultados de busqueda.", "type": "integer", "default": 100, "minimum": 1, "maximum": 200, "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 200, "invalidConsequence": "El proceso falla al iniciar." },
      "MaxTop": { "appSetting": "AzureDevOps__Search__MaxTop", "purpose": "Maximo solicitado por una busqueda; debe ser mayor o igual a DefaultTop.", "type": "integer", "default": 200, "minimum": 1, "maximum": 200, "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 200, "invalidConsequence": "El proceso falla al iniciar." },
