  "Authentication": {
    // No existe autenticacion de plataforma declarada por este repositorio.
    "Owner": "HttpTrigger AuthorizationLevel.Anonymous",
    "LocalBehavior": "Mismo nivel anonimo que los ambientes desplegados"
  },
  "Cors": {
    // No existe Cors__AllowedOrigins interno. Azure usa ARM web.cors y local usa Core Tools.
    "AzureOwner": "ARM web.cors",
    "LocalAllowedOrigin": "http://localhost:4200",
    "SupportCredentials": false
  }
}
