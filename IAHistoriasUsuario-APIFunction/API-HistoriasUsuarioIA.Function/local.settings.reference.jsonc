    },
    "Http": {
      "TimeoutSeconds": { "appSetting": "AzureDevOps__Http__TimeoutSeconds", "purpose": "Timeout por intento Azure DevOps; junto con retries y backoff no puede superar 600000 ms totales.", "type": "integer", "default": 100, "minimum": 1, "maximum": 300, "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 300, "invalidConsequence": "El proceso falla al iniciar." },
      "RetryCount": { "appSetting": "AzureDevOps__Http__RetryCount", "purpose": "Reintentos acotados de lecturas idempotentes, dentro del presupuesto total de 600000 ms.", "type": "integer", "default": 2, "minimum": 0, "maximum": 5, "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 5, "invalidConsequence": "El proceso falla al iniciar." },
      "RetryDelayMilliseconds": { "appSetting": "AzureDevOps__Http__RetryDelayMilliseconds", "purpose": "Demora inicial del backoff Azure DevOps, incluida en el presupuesto total de 600000 ms.", "type": "integer", "default": 500, "minimum": 0, "maximum": 60000, "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 60000, "invalidConsequence": "El proceso falla al iniciar." }
    },
    "Defaults": {
      "Organization": { "appSetting": "AzureDevOps__Defaults__Organization", "purpose": "Organizacion usada solo si el request no aporta contexto.", "type": "string", "default": "", "minimum": 0, "maximum": "AzureDevOps__Limits__MaxOrganizationLength", "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 256, "invalidConsequence": "El proceso falla al iniciar." },
      "Project": { "appSetting": "AzureDevOps__Defaults__Project", "purpose": "Proyecto usado solo si el request no aporta contexto.", "type": "string", "default": "", "minimum": 0, "maximum": "AzureDevOps__Limits__MaxProjectLength", "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 256, "invalidConsequence": "El proceso falla al iniciar." },
      "AreaPath": { "appSetting": "AzureDevOps__Defaults__AreaPath", "purpose": "Area Path usado solo si el request no lo aporta.", "type": "string", "default": "", "minimum": 0, "maximum": "AzureDevOps__Limits__MaxPathLength", "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 4000, "invalidConsequence": "El proceso falla al iniciar." },
      "IterationPath": { "appSetting": "AzureDevOps__Defaults__IterationPath", "purpose": "Iteration Path usado solo si el request no lo aporta.", "type": "string", "default": "", "minimum": 0, "maximum": "AzureDevOps__Limits__MaxPathLength", "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 4000, "invalidConsequence": "El proceso falla al iniciar." }
    },
    "Limits": {
      "MaxOrganizationLength": { "appSetting": "AzureDevOps__Limits__MaxOrganizationLength", "purpose": "Longitud maxima de organizacion.", "type": "integer", "default": 256, "minimum": 1, "maximum": 256, "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 256, "invalidConsequence": "El proceso falla al iniciar." },
      "MaxProjectLength": { "appSetting": "AzureDevOps__Limits__MaxProjectLength", "purpose": "Longitud maxima de proyecto o tipo corto.", "type": "integer", "default": 256, "minimum": 1, "maximum": 256, "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 256, "invalidConsequence": "El proceso falla al iniciar." },
      "MaxPathLength": { "appSetting": "AzureDevOps__Limits__MaxPathLength", "purpose": "Longitud maxima de Area/Iteration/Azure Path.", "type": "integer", "default": 4000, "minimum": 1, "maximum": 4000, "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 4000, "invalidConsequence": "El proceso falla al iniciar." },
      "MaxWorkItemIds": { "appSetting": "AzureDevOps__Limits__MaxWorkItemIds", "purpose": "Cantidad maxima de Work Item IDs por request de comentarios.", "type": "integer", "default": 200, "minimum": 1, "maximum": 200, "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 200, "invalidConsequence": "El proceso falla al iniciar." },
      "MaxReferenceNameLength": { "appSetting": "AzureDevOps__Limits__MaxReferenceNameLength", "purpose": "Longitud maxima de referenceName dinamico.", "type": "integer", "default": 256, "minimum": 1, "maximum": 256, "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 256, "invalidConsequence": "El proceso falla al iniciar." },
      "ReferenceNameRegexTimeoutMilliseconds": { "appSetting": "AzureDevOps__Limits__ReferenceNameRegexTimeoutMilliseconds", "purpose": "Timeout de regex para validar referenceName.", "type": "integer", "default": 100, "minimum": 1, "maximum": 100, "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 100, "invalidConsequence": "El proceso falla al iniciar." }
    },
    "Queries": {
      "ProjectsTop": { "appSetting": "AzureDevOps__Queries__ProjectsTop", "purpose": "Tamano de pagina al listar proyectos.", "type": "integer", "default": 100, "minimum": 1, "maximum": 100, "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 100, "invalidConsequence": "El proceso falla al iniciar." },
      "ClassificationDepth": { "appSetting": "AzureDevOps__Queries__ClassificationDepth", "purpose": "Profundidad solicitada para classification nodes.", "type": "integer", "default": 100, "minimum": 1, "maximum": 100, "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 100, "invalidConsequence": "El proceso falla al iniciar." },
      "CommentsTop": { "appSetting": "AzureDevOps__Queries__CommentsTop", "purpose": "Tamano de pagina al consultar comentarios.", "type": "integer", "default": 200, "minimum": 1, "maximum": 200, "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 200, "invalidConsequence": "El proceso falla al iniciar." },
      "TestPlansTop": { "appSetting": "AzureDevOps__Queries__TestPlansTop", "purpose": "Tamano de pagina al listar Test Plans.", "type": "integer", "default": 50, "minimum": 1, "maximum": 50, "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 50, "invalidConsequence": "El proceso falla al iniciar." }
    },
