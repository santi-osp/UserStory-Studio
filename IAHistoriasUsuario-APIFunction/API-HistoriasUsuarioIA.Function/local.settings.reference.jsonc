    "MaxTestCases": { "appSetting": "WorkItemLimits__MaxTestCases", "purpose": "Cantidad maxima unica de Test Cases por payload o salida IA.", "type": "integer", "default": 50, "minimum": 1, "maximum": 50, "required": false, "secret": false, "conditionalProvider": null, "optional": true, "absoluteCeiling": 50, "invalidConsequence": "El proceso falla al iniciar." },
